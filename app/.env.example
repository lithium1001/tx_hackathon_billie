# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Every variable is read in dcta/utils/config.py and nowhere else.

# --- LLM endpoint (any OpenAI-compatible /chat/completions API) --------------
DCTA_LLM_BASE_URL=https://openrouter.ai/api/v1
DCTA_LLM_API_KEY=
DCTA_MODEL=google/gemma-4-31b-it

# The validator is a second, independent engine. Give it a different model so the
# two do not fail in the same place; unset, it shares DCTA_MODEL.
# DCTA_VALIDATOR_MODEL=mistralai/mistral-small-3.2-24b-instruct   # different vendor from DCTA_MODEL

# --- Gateway ------------------------------------------------------------------
# DCTA_GATEWAY_URL=http://127.0.0.1:8100   # read-only queries from the agent

# DCTA_DEMO=1                              # show the demo-only audit tamper switch

# --- Optional ---------------------------------------------------------------
# DCTA_MIN_INTERVAL=3.5                    # min seconds between LLM calls
# DCTA_MAX_RETRIES=3                       # retries on a transient gateway error
# DCTA_MAX_TOKENS=2048                     # cap output tokens (0 = provider default)
# DCTA_CONTEXT_LIMIT=32768                 # total context window, if known
# DCTA_SSL_CA_BUNDLE=/path/to/private-ca.pem
# DCTA_VERIFY_SSL=1                        # 0 disables TLS verification (trusted networks only)
# DCTA_ARTIFACTS_DIR=artifacts             # where runs.csv and other run output go
